<% content_for :title, "New password" %>

<%= render layout: "layouts/auth_panel", locals: { title: "Choose a new password" } do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "label" %>
      <%= form.password_field :password, required: true, autofocus: true,
            autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Repeat password", class: "label" %>
      <%= form.password_field :password_confirmation, required: true,
            autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>

    <%= form.submit "Save password", class: "btn btn-primary w-full" %>
  <% end %>
<% end %>
