<% content_for :title, "Reset password" %>

<%= render layout: "layouts/auth_panel",
           locals: { title: "Reset your password",
                     subtitle: "We'll email you a link to set a new one." } do %>
  <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address], class: "field" %>
    </div>

    <%= form.submit "Email reset instructions", class: "btn btn-primary w-full" %>

    <p class="pt-1 text-center text-sm">
      <%= link_to "Back to sign in", new_session_path, class: "text-ink-faint hover:text-ink" %>
    </p>
  <% end %>
<% end %>
