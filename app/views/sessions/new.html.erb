<% content_for :title, "Sign in" %>

<%= render layout: "layouts/auth_panel", locals: { title: "Sign in" } do %>
  <%= form_with url: session_url, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address], class: "field" %>
    </div>

    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true,
            autocomplete: "current-password", maxlength: 72, class: "field" %>
    </div>

    <%= form.submit "Sign in", class: "btn btn-primary w-full" %>

    <p class="pt-1 text-center text-sm">
      <%= link_to "Forgot your password?", new_password_path, class: "text-ink-faint hover:text-ink" %>
    </p>
  <% end %>
<% end %>
