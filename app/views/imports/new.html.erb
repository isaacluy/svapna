<% content_for :title, "Import" %>

<div class="mx-auto max-w-3xl px-5 py-10">
  <%= link_to "← Imports", imports_path, class: "text-sm text-ink-faint hover:text-ink" %>
  <h1 class="mt-6 font-serif text-3xl font-medium tracking-tight">Import from Apple Notes</h1>

  <p class="mt-3 max-w-measure text-sm leading-relaxed text-ink-muted">
    Paste a note, or choose one or more exported <code class="rounded bg-surface-sunk px-1 py-0.5 text-xs">.txt</code> files.
    Each file becomes its own import you can undo on its own, and importing the
    same note twice is safe — entries already present are skipped.
  </p>

  <%= form_with url: imports_path, method: :post, multipart: true, class: "mt-8 space-y-6" do %>
    <div>
      <%= label_tag "import[files]", "Files", class: "label" %>
      <%= file_field_tag "import[files][]", multiple: true, accept: ".txt,text/plain",
            class: "block w-full text-sm file:mr-3 file:rounded-md file:border-0 file:bg-surface-sunk file:px-3 file:py-2 file:text-sm file:font-medium file:text-ink" %>
    </div>

    <div class="flex items-center gap-3 text-xs text-ink-faint">
      <span class="h-px flex-1 bg-rule"></span>or<span class="h-px flex-1 bg-rule"></span>
    </div>

    <div>
      <%= label_tag "import[text]", "Paste a note", class: "label" %>
      <%= text_area_tag "import[text]", nil, rows: 14, spellcheck: false,
            placeholder: "Sueños p.14\n———\n2026/09/18\n\n…",
            class: "field font-mono text-[0.8125rem] leading-relaxed" %>
      <p class="mt-2 text-xs text-ink-faint">
        Include the note's title line — it becomes the source of every entry in it.
      </p>
    </div>

    <%= submit_tag "Import", class: "btn btn-primary" %>
  <% end %>
</div>
