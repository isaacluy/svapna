<% content_for :title, @import.to_s %>

<div class="mx-auto max-w-3xl px-5 py-10">
  <%= link_to "← Imports", imports_path, class: "text-sm text-ink-faint hover:text-ink" %>

  <h1 class="mt-6 font-serif text-3xl font-medium tracking-tight">
    <%= @import.source.presence || @import.filename.presence || "Import ##{@import.id}" %>
  </h1>
  <p class="mt-2 text-sm text-ink-faint">
    <%= pluralize(@import.entries_count, "entry") %> imported
    <% if @import.duplicate_count.positive? %>· <%= @import.duplicate_count %> already present<% end %>
    <% if @import.filename.present? %>· <%= @import.filename %><% end %>
  </p>

  <% if @import.empty? %>
    <div class="card mt-8 border-marker/30 bg-marker-soft px-5 py-4">
      <p class="text-sm text-marker">
        Nothing was imported. The most likely cause is that the divider lines were
        not recognised — they need to be a line of three or more dashes.
      </p>
    </div>
  <% end %>

  <% if @import.parse_errors.any? %>
    <div class="card mt-8 bg-marker-soft px-5 py-4">
      <h2 class="text-sm font-medium text-marker">
        <%= pluralize(@import.parse_errors.size, "section") %> skipped
      </h2>
      <ul class="mt-3 space-y-2.5 text-sm text-marker">
        <% @import.parse_errors.each do |problem| %>
          <li>
            <%= problem["reason"] %>
            <% if problem["preview"].present? %>
              <span class="mt-0.5 block font-mono text-xs opacity-70"><%= problem["preview"] %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @entries.any? %>
    <h2 class="mt-12 text-xs font-semibold tracking-wide text-ink-faint uppercase">Entries</h2>
    <ul class="mt-1 divide-y divide-rule">
      <%= render @entries %>
    </ul>
  <% end %>

  <% if @import.undoable? %>
    <div class="mt-12 border-t border-rule pt-5">
      <%= button_to "Undo this import", @import, method: :delete,
            class: "btn btn-danger text-sm",
            form: { data: { turbo_confirm: "Delete the #{@import.entries_count} entries this import created?" } } %>
      <p class="mt-1 text-xs text-ink-faint">
        Deletes only the entries this import created. Entries you wrote here are untouched.
      </p>
    </div>
  <% end %>
</div>
