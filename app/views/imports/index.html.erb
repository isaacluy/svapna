<div class="mx-auto max-w-2xl px-4 py-12">
  <div class="flex items-baseline justify-between">
    <h1 class="text-2xl font-semibold tracking-tight">Imports</h1>
    <%= link_to "New import", new_import_path, class: "text-sm underline" %>
  </div>

  <% if @imports.empty? %>
    <p class="mt-8 text-gray-600">Nothing imported yet.</p>
  <% else %>
    <ul class="mt-8 divide-y divide-gray-200">
      <% @imports.each do |import| %>
        <li class="flex items-baseline justify-between py-4">
          <div>
            <%= link_to import.to_s, import, class: "font-medium underline" %>
            <p class="mt-1 text-sm text-gray-600">
              <%= pluralize(import.entries_count, "entry") %>
              <% if import.duplicate_count.positive? %>· <%= import.duplicate_count %> duplicate<% end %>
              <% if import.skipped_count.positive? %>· <span class="text-amber-700"><%= import.skipped_count %> skipped</span><% end %>
            </p>
          </div>
          <span class="text-xs text-gray-500"><%= import.created_at.to_fs(:short) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
