<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <div class="mx-auto max-w-3xl px-5 pt-4">
    <p role="status" class="rounded-lg px-4 py-2.5 text-sm <%= type.to_s == "alert" ? "bg-marker-soft text-danger" : "bg-accent-soft text-ink" %>">
      <%= message %>
    </p>
  </div>
<% end %>
