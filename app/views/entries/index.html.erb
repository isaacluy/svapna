<% content_for :title, "Entries" %>

<div class="mx-auto max-w-3xl px-5 py-10">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h1 class="font-serif text-3xl font-medium tracking-tight">Entries</h1>

    <div class="flex items-center gap-4 text-sm">
      <%= link_to "Import", new_import_path, class: "link" %>
      <%= link_to "New entry", new_entry_path, class: "btn btn-primary" %>
    </div>
  </div>

  <p class="mt-2 text-sm text-ink-faint">
    <%= pluralize(@total, "entry") %>
    <% if @total > EntriesController::PAGE_SIZE %>
      · showing the most recent <%= EntriesController::PAGE_SIZE %>
    <% end %>
  </p>

  <% if @entries.empty? %>
    <div class="card mt-10 px-6 py-12 text-center">
      <p class="font-serif text-lg">Nothing here yet.</p>
      <p class="mt-2 text-sm text-ink-muted">
        <%= link_to "Import your notes", new_import_path, class: "link" %>
        or <%= link_to "write an entry", new_entry_path, class: "link" %>.
      </p>
    </div>
  <% else %>
    <ul class="mt-6 divide-y divide-rule">
      <%= render @entries %>
    </ul>
  <% end %>
</div>
