<%= form_with model: entry, class: "space-y-4" do |f| %>
  <% if entry.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-800">
      <ul class="list-disc pl-5">
        <% entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :written_on, "Date", class: "block text-sm font-medium" %>
    <%= f.date_field :written_on, class: "mt-1 rounded-md border-gray-300" %>
  </div>

  <div>
    <%= f.label :body, class: "block text-sm font-medium" %>
    <%= f.text_area :body, rows: 16,
          class: "mt-1 block w-full rounded-md border-gray-300 font-serif" %>
  </div>

  <div class="flex flex-wrap gap-4">
    <div>
      <%= f.label :language, class: "block text-sm font-medium" %>
      <%= f.select :language, Entry::LANGUAGES, {}, class: "mt-1 rounded-md border-gray-300" %>
    </div>

    <div>
      <%= f.label :status, class: "block text-sm font-medium" %>
      <%= f.select :status, Entry.statuses.keys, {}, class: "mt-1 rounded-md border-gray-300" %>
    </div>

    <div>
      <%= f.label :source, "Source note", class: "block text-sm font-medium" %>
      <%= f.text_field :source, placeholder: "Sueños p.14",
            class: "mt-1 rounded-md border-gray-300" %>
    </div>
  </div>

  <%= f.submit class: "rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white" %>
<% end %>
