<%= form_with model: entry, class: "space-y-6" do |f| %>
  <% if entry.errors.any? %>
    <div class="rounded-lg bg-marker-soft px-4 py-3 text-sm text-danger">
      <ul class="list-disc space-y-1 pl-4">
        <% entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :body, "Entry", class: "label" %>
    <%= f.text_area :body, rows: 18,
          class: "field prose-entry !text-base",
          placeholder: "Anoche soñé…" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :written_on, "Date", class: "label" %>
      <%= f.date_field :written_on, class: "field" %>
    </div>

    <div>
      <%= f.label :status, class: "label" %>
      <%= f.select :status, Entry.statuses.keys.map { |s| [ s.humanize, s ] }, {}, class: "field" %>
    </div>

    <div>
      <%= f.label :language, class: "label" %>
      <%= f.select :language, Entry::LANGUAGES.map { |l| [ l.upcase, l ] }, {}, class: "field" %>
    </div>

    <div>
      <%= f.label :source, "Source note", class: "label" %>
      <%= f.text_field :source, placeholder: "Sueños p.14", class: "field" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :tag_list, "Tags", class: "label" %>
      <%= f.text_field :tag_list, value: entry.tag_list, list: "known-tags",
            autocomplete: "off", placeholder: "pesadilla, volar",
            class: "field" %>
      <datalist id="known-tags">
        <% Tag.in_use.alphabetical.each do |tag| %>
          <option value="<%= tag.name %>"></option>
        <% end %>
      </datalist>
      <p class="mt-1.5 text-xs text-ink-faint">Comma separated. Existing tags are suggested as you type.</p>
    </div>
  </div>

  <div class="flex items-center gap-4 pt-1">
    <%= f.submit entry.persisted? ? "Save" : "Create entry", class: "btn btn-primary" %>
    <%= link_to "Cancel", entry.persisted? ? entry_path(entry) : entries_path,
          class: "text-sm text-ink-faint hover:text-ink" %>
  </div>
<% end %>
