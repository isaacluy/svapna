<% if search.total_pages > 1 %>
  <nav class="mt-10 flex items-center justify-between border-t border-rule pt-5 text-sm" aria-label="Pagination">
    <% if search.previous_page %>
      <%= link_to "← Newer", search_path_with(search, page: search.previous_page), class: "link" %>
    <% else %>
      <span class="text-ink-faint">← Newer</span>
    <% end %>

    <span class="text-xs text-ink-faint">
      Page <%= search.page %> of <%= search.total_pages %>
    </span>

    <% if search.next_page %>
      <%= link_to "Older →", search_path_with(search, page: search.next_page), class: "link" %>
    <% else %>
      <span class="text-ink-faint">Older →</span>
    <% end %>
  </nav>
<% end %>
