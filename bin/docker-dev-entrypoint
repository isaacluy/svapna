#!/usr/bin/env bash
set -e

# Gems live in a named volume rather than the image, so they are reconciled at
# boot instead of at build. `bundle check` is a fast no-op when in sync, which
# is what makes `bin/d add <gem>` work with a restart instead of a rebuild.
if ! bundle check >/dev/null 2>&1; then
  echo "==> Gemfile changed, installing gems"
  bundle install
fi

# bin/dev shells out to foreman; keep it in the same volume so it persists.
gem list -i foreman >/dev/null 2>&1 || gem install foreman --no-document

# A hard-killed container leaves this behind, and Puma then refuses to boot
# with "A server is already running".
rm -f tmp/pids/server.pid

exec "$@"
